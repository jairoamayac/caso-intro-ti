    <bpmn:sequenceFlow id="Flow_21" name="Sí" sourceRef="G5" targetRef="A10" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="A10" targetRef="G6" />
    <bpmn:sequenceFlow id="Flow_23" name="Sí" sourceRef="G6" targetRef="A8" />
    <bpmn:sequenceFlow id="Flow_24" name="No" sourceRef="G6" targetRef="A11" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="A11" targetRef="E3" />
  </bpmn:process>

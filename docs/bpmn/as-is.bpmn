    <bpmn:sequenceFlow id="Flow_16" name="Sí" sourceRef="G4" targetRef="A8" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="A8" targetRef="A9" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="A9" targetRef="E1" />
    <bpmn:sequenceFlow id="Flow_19" name="No" sourceRef="G4" targetRef="G5" />

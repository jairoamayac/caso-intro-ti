<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_as_is" targetNamespace="http://niagara.example/pa">
  <bpmn:collaboration id="Collab_as_is">
    <bpmn:participant id="Pool_as_is" name="Autorización previa (AS_IS)" processRef="Proc_as_is" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_as_is" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_med" name="Médico / Consulta">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_coord" name="Coordinador PA (manual + Excel)">
        <bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_pag" name="Pagador (EPS / Prepagada / Sisbén)">
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_pac" name="Paciente">
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Necesidad de servicio">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="A1" name="Enviar orden (sistema citas / fax / teléfono)">
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="A2" name="Transcribir caso al Excel compartido">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="A3" name="Login portal o llamar para verificar cobertura">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="¿Requiere PA?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A4" name="Llamar a consulta para pedir documentos">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="A5" name="Buscar y enviar notas / resultados">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="¿Documentación completa? (68% NO, 2,3 contactos)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A6" name="Compilar paquete y radicar (portal / fax / WhatsApp)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="P1" name="Revisar solicitud (mismo día a 14+ días)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="T1" name="Esperar 1 día">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_T1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="A7" name="Consultar estado en portal manualmente">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3" name="¿Hay decisión?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G4" name="¿Aprobada? (18,4% negada)">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A8" name="Registrar aprobación y notificar">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="A9" name="Agendar y prestar servicio">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Servicio prestado">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G5" name="¿Hay tiempo para revisar?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Negación abandonada (59%)">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="A10" name="Programar llamada de revisión (48-72 h)">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G6" name="¿Revocada?">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A11" name="Preparar carta de tutela con pruebas">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E3" name="Tutela radicada (31% éxito)">
      <bpmn:incoming>Flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="S" targetRef="A1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="A1" targetRef="A2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="A2" targetRef="A3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="A3" targetRef="G1" />
    <bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="G1" targetRef="A9" />
    <bpmn:sequenceFlow id="Flow_5" name="Sí" sourceRef="G1" targetRef="A4" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="A4" targetRef="A5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="A5" targetRef="G2" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="G2" targetRef="A4" />
    <bpmn:sequenceFlow id="Flow_9" name="Sí" sourceRef="G2" targetRef="A6" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="A6" targetRef="P1" />
